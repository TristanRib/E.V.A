# Copier ce fichier en .env puis renseigner les valeurs.
# Les lignes laissées vides prennent la valeur par défaut.

# --- Cœur ---
# Fournisseur de LLM : ollama
EVA_PROVIDER=ollama
# Modèle ; vide = modèle recommandé du fournisseur (qwen3:4b-instruct pour Ollama)
EVA_MODEL=
# Longueur maximale d'une réponse, en tokens
EVA_MAX_TOKENS=1024
# Prénom utilisé par E.V.A pour s'adresser à vous
EVA_USER_NAME=Tristan
# Nombre d'échanges conservés en mémoire de conversation
EVA_HISTORY_TURNS=20
# Plugins activés, séparés par des virgules ; vide = tous (clock, hue)
EVA_PLUGINS=
EVA_LOG_LEVEL=WARNING

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
# Fenêtre de contexte en tokens : plus grand = mémoire plus longue, plus de VRAM
OLLAMA_CONTEXT_SIZE=8192
# Durée de maintien du modèle en VRAM après usage : 30m, 2h, -1 (toujours)
OLLAMA_KEEP_ALIVE=30m

# --- Plugin Philips Hue ---
# Renseignés automatiquement par `uv run eva-hue-pair`.
HUE_BRIDGE_IP=
HUE_APP_KEY=
